#! C:/Program Files/Nuke15.2v7/nuke-15.2.7.dll -nx
version 15.2 v7
Gizmo {
 knobChanged "\nk = nuke.thisKnob()\nn = nuke.thisNode()\nb = n.node('BlinkScript1')\n\n# Light Type → show/hide\nif k.name() in \['lightType', 'showPanel']:\n    lt = n\['lightType'].value()\n    n\['lightDir'].setVisible(lt == 'Directional')\n    n\['lightPos'].setVisible(lt == 'Point')\n    n\['falloffRadius'].setVisible(lt == 'Point')\n    n\['falloffType'].setVisible(lt == 'Point')\n\n# Enable Specular → show/hide\nif k.name() in \['enableSpec', 'showPanel']:\n    specOn = n\['enableSpec'].value()\n    n\['specIntensity'].setVisible(specOn)\n    n\['shininess'].setVisible(specOn)\n    n\['fresnelStrength'].setVisible(specOn)\n    n\['cameraPos'].setVisible(specOn)\n    n\['autoDetect'].setVisible(specOn)\n\n# Comp Mode → Switch\nif k.name() in \['compMode', 'showPanel']:\n    mode = n\['compMode'].value()\n    sw = n.node('Switch1')\n    if sw:\n        modes = \{'Add to Beauty': 0, 'Replace Lighting': 1, 'Relight Only': 2, 'Source': 3\}\n        sw\['which'].setValue(modes.get(mode, 0))\n\n# Pass values to BlinkScript\nif b:\n    b\['AOV_Relight_Light Type'].setValue(0 if n\['lightType'].value() == 'Directional' else 1)\n    b\['AOV_Relight_Light Direction'].setValue(n\['lightDir'].value())\n    b\['AOV_Relight_Light Position'].setValue(n\['lightPos'].value())\n    b\['AOV_Relight_Light Color'].setValue(n\['lightColor'].value())\n    b\['AOV_Relight_Intensity'].setValue(n\['intensity'].value())\n    b\['AOV_Relight_Ambient'].setValue(n\['ambient'].value())\n    b\['AOV_Relight_Wrap'].setValue(n\['wrap'].value())\n    b\['AOV_Relight_Enable Specular'].setValue(n\['enableSpec'].value())\n    b\['AOV_Relight_Spec Intensity'].setValue(n\['specIntensity'].value())\n    b\['AOV_Relight_Shininess'].setValue(n\['shininess'].value())\n    b\['AOV_Relight_Fresnel Strength'].setValue(n\['fresnelStrength'].value())\n    b\['AOV_Relight_Falloff Radius'].setValue(n\['falloffRadius'].value())\n    b\['AOV_Relight_Falloff Type'].setValue(int(n\['falloffType'].getValue()))\n    b\['AOV_Relight_Camera Position'].setValue(n\['cameraPos'].value())\n"
 addUserKnob {20 lightTab l Light}
 addUserKnob {4 lightType l "Light Type" M {Directional Point}}
 addUserKnob {26 div1 l "" +STARTLINE}
 addUserKnob {13 lightDir l "Light Direction"}
 lightDir {0 -1 0.5}
 addUserKnob {13 lightPos l "Light Position" +HIDDEN}
 lightPos {0 200 0}
 addUserKnob {7 falloffRadius l "Falloff Radius" +HIDDEN R 1 2000}
 falloffRadius 500
 addUserKnob {4 falloffType l "Falloff Type" +HIDDEN M {Linear Quadratic}}
 falloffType Quadratic
 addUserKnob {26 div2 l "" +STARTLINE}
 addUserKnob {19 lightColor l "Light Color"}
 lightColor {0.9 0.95 0.9 1}
 addUserKnob {6 lightColor_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {7 intensity l Intensity R 0 5}
 intensity 3.74
 addUserKnob {7 ambient l Ambient}
 ambient 0.715
 addUserKnob {7 wrap l Wrap}
 wrap 0.22
 addUserKnob {20 specTab l Specular}
 addUserKnob {6 enableSpec l "Enable Specular" +STARTLINE}
 enableSpec true
 addUserKnob {7 specIntensity l "Spec Intensity" R 0 3}
 specIntensity 0.5
 addUserKnob {7 shininess l Shininess R 2 256}
 shininess 32
 addUserKnob {7 fresnelStrength l "Fresnel Strength" R 0 3}
 fresnelStrength 1
 addUserKnob {20 optionsTab l Options}
 addUserKnob {13 cameraPos l "Camera Position"}
 cameraPos {0 0 10}
 addUserKnob {22 autoDetect l "Auto-Detect from EXR" -STARTLINE T "\nn = nuke.thisNode()\ninp = n.input(0)\nif inp:\n    meta = inp.metadata()\n    xform = meta.get('exr/rs/camera/transform')\n    if xform:\n        n\['cameraPos'].setValue(\[xform\[12], xform\[13], xform\[14]])\n        nuke.message('Camera detected: X=%.3f Y=%.3f Z=%.3f' % (xform\[12], xform\[13], xform\[14]))\n    else:\n        nuke.message('No camera metadata found in EXR.')\nelse:\n    nuke.message('No input connected.')\n"}
 addUserKnob {26 div3 l "" +STARTLINE}
 addUserKnob {4 compMode l "Comp Mode" M {"Add to Beauty" "Replace Lighting" "Relight Only" Source}}
}
